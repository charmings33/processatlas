    jprx:citation "Noguchi (2003), The effect of the quality-oriented production approach on the delivery of prefabricated homes in Japan, Journal of Housing and the Built Environment 18(4):353-364, doi:10.1023/B:JOHO.0000005759.07212.00" ;
    jprx:evidence "peer-reviewed" ;
    jprx:relationType "enablesCapability" ;
    jprx:source jprx:AT8 ;
    jprx:target jprx:VA3 ;
    rdfs:comment "quality-oriented industrialised production considerably increases housing quality by providing standard fittings (Japanese housemakers)" .

jprx:DEP99 a jprx:Dependency ;
    jprx:citation "Keskiniva, Saari & Junnonen (2020), Takt Planning in Apartment Building Renovation Projects, Buildings 10(12):226, doi:10.3390/buildings10120226" ;
    jprx:evidence "peer-reviewed" ;
    jprx:relationType "hasPrecondition" ;
    jprx:source jprx:PR18 ;
    jprx:target jprx:AR14 ;
    rdfs:comment "production with short takt requires a highly detailed definition of tasks to avoid ambiguousness" .

