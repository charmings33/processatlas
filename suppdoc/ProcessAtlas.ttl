    jprx:citation "Garcia de Soto, Agusti-Juan, Hunhevicz, Joss, Graser, Habert & Adey (2018), Productivity of digital fabrication in construction: Cost and time analysis of a robotically built wall, Automation in Construction 92:297-311, doi:10.1016/j.autcon.2018.04.004" ;
    jprx:dependencyNote "productivity is higher when the robotic method is used for geometrically complex walls (Mesh Mould, DFAB HOUSE)" ;
    jprx:dependencyRelation "amplifies" ;
    jprx:dependencySource jprx:PR4 ;
    jprx:dependencyTarget jprx:VA2 ;
    jprx:evidenceLevel "peer-reviewed" .

jprx:DEP96 a jprx:Dependency ;
    jprx:citation "Gharbia, Chang-Richards, Xu, Hook, Stehn, Jahne, Hall, Park, Hong & Feng (2023), Building Code Compliance for Off-Site Construction, Journal of Legal Affairs and Dispute Resolution in Engineering and Construction 15(2):04522056, doi:10.1061/JLADAH.LADR-856" ;
    jprx:dependencyNote "a functional regulatory system for offsite compliance requires third-party certification and traceability" ;
    jprx:dependencyRelation "dependsOn" ;
    jprx:dependencySource jprx:PR2 ;
    jprx:dependencyTarget jprx:RI18 ;
    jprx:evidenceLevel "peer-reviewed" .

jprx:DEP97 a jprx:Dependency ;
    jprx:citation "Yuan, Sun & Wang (2018), Design for Manufacture and Assembly-oriented parametric design of prefabricated buildings, Automation in Construction 88:13-22, doi:10.1016/j.autcon.2017.12.021" ;
    jprx:dependencyNote "DfMA-oriented process combines DfMA with BIM parametric design to support manufacture and assembly" ;
    jprx:dependencyRelation "dependsOn" ;
    jprx:dependencySource jprx:PR9 ;
    jprx:dependencyTarget jprx:RE1 ;
    jprx:evidenceLevel "peer-reviewed" .

jprx:DEP98 a jprx:Dependency ;
    jprx:citation "Noguchi (2003), The effect of the quality-oriented production approach on the delivery of prefabricated homes in Japan, Journal of Housing and the Built Environment 18(4):353-364, doi:10.1023/B:JOHO.0000005759.07212.00" ;
    jprx:dependencyNote "quality-oriented industrialised production considerably increases housing quality by providing standard fittings (Japanese housemakers)" ;
    jprx:dependencyRelation "enablesCapability" ;
    jprx:dependencySource jprx:AT8 ;
    jprx:dependencyTarget jprx:VA3 ;
    jprx:evidenceLevel "peer-reviewed" .

jprx:DEP99 a jprx:Dependency ;
    jprx:citation "Keskiniva, Saari & Junnonen (2020), Takt Planning in Apartment Building Renovation Projects, Buildings 10(12):226, doi:10.3390/buildings10120226" ;
